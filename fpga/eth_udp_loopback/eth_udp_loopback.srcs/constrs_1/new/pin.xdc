#set UnusedPin
set_property BITSTREAM.CONFIG.UNUSEDPIN Pullnone [current_design]

#reset active low,S4
set_property PACKAGE_PIN F20 [get_ports reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports reset_n]

#led pin
set_property PACKAGE_PIN G17 [get_ports {led[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[0]}]
set_property PACKAGE_PIN G19 [get_ports {led[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[1]}]
set_property PACKAGE_PIN G20 [get_ports {led[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[2]}]
set_property PACKAGE_PIN G18 [get_ports {led[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[3]}]
set_property PACKAGE_PIN K19 [get_ports {led[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[4]}]
set_property PACKAGE_PIN J18 [get_ports {led[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[5]}]
set_property PACKAGE_PIN H17 [get_ports {led[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[6]}]
set_property PACKAGE_PIN K18 [get_ports {led[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[7]}]

set_property IOSTANDARD LVCMOS33 [get_ports {rgmii_rxd[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {rgmii_rxd[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {rgmii_rxd[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {rgmii_rxd[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {rgmii_txd[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {rgmii_txd[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {rgmii_txd[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {rgmii_txd[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports rgmii_rxdv]
set_property IOSTANDARD LVCMOS33 [get_ports rgmii_tx_clk]
set_property IOSTANDARD LVCMOS33 [get_ports rgmii_txen]
set_property IOSTANDARD LVCMOS33 [get_ports rgmii_rx_clk_i]
set_property IOSTANDARD LVCMOS33 [get_ports eth_rstn]
set_property IOSTANDARD LVCMOS33 [get_ports eth_mdc]
set_property IOSTANDARD LVCMOS33 [get_ports eth_mdio]
set_property PACKAGE_PIN P15 [get_ports {rgmii_rxd[3]}]
set_property PACKAGE_PIN Y16 [get_ports {rgmii_rxd[2]}]
set_property PACKAGE_PIN V15 [get_ports {rgmii_rxd[1]}]
set_property PACKAGE_PIN P14 [get_ports {rgmii_rxd[0]}]
set_property PACKAGE_PIN U20 [get_ports {rgmii_txd[3]}]
set_property PACKAGE_PIN T20 [get_ports {rgmii_txd[2]}]
set_property PACKAGE_PIN T19 [get_ports {rgmii_txd[1]}]
set_property PACKAGE_PIN R18 [get_ports {rgmii_txd[0]}]
set_property PACKAGE_PIN Y14 [get_ports rgmii_rxdv]
set_property PACKAGE_PIN P16 [get_ports rgmii_tx_clk]
set_property PACKAGE_PIN T17 [get_ports rgmii_txen]
set_property PACKAGE_PIN N18 [get_ports rgmii_rx_clk_i]
set_property PACKAGE_PIN B19 [get_ports eth_rstn]
set_property PACKAGE_PIN C20 [get_ports eth_mdc]
set_property PACKAGE_PIN B20 [get_ports eth_mdio]
